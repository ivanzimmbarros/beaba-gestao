# BeaBa Gestão — variáveis de ambiente (exemplo)

#

# Copie para `.env` na raiz do repositório e ajuste. O ficheiro `.env` não deve ser

# versionado (contém caminhos e segredos).

#

# Precedência sobre o `.env`: variáveis já exportadas no processo / container mantêm-se

# (`load_dotenv(..., override=False)` em `src/database/connection.py`).



# -----------------------------------------------------------------------------

# Ambiente da instância (sidebar: «Ambiente: …»). Valores comuns:

# local | development | staging | production (ou aliases stg | prod | dev).

# -----------------------------------------------------------------------------

ENV_TYPE=local

# Streamlit Cloud (Secrets de cada app — branch main NÃO define isto automaticamente):
#   Produção (gestaobeaba…):  ENV_TYPE = production   (ou BEABA_ENV = production / main)
#   Staging:                 ENV_TYPE = staging
#   Dev:                     ENV_TYPE = dev
# Se só tiver S3_UPLOAD_PREFIX (ex.: production/hourly/), o selo da sidebar infere produção.

# Opcional — alias aceite pelo mesmo leitor em código:

# BEABA_ENV=staging



# -----------------------------------------------------------------------------

# SQLite — caminho do ficheiro da base principal.

# `BEABA_SQLITE_PATH` tem precedência sobre `DB_PATH`; use apenas uma se possível.

# Caminhos relativos resolvem contra a raiz do projecto (pasta onde está este ficheiro de exemplo).

# -----------------------------------------------------------------------------

BEABA_SQLITE_PATH=data/beaba_gestao.db

# DB_PATH=/var/beaba/beaba_prod.db



# -----------------------------------------------------------------------------

# Opcional — personalização já lida pela app (homepage).

# -----------------------------------------------------------------------------

# BEABA_HOME_DISPLAY_NAME=Lara

# URL pública da app (links em e-mails MFA / recuperação de senha). Opcional — se vazio, infere DEV/STG/PROD por ENV_TYPE.
# BEABA_PUBLIC_APP_URL=https://dev-beabagestao.streamlit.app



# -----------------------------------------------------------------------------

# Bootstrap — administrador inicial (apenas se `usuarios` está vazio ao correr `create_tables`).

# E-mail por defeito no bootstrap (base vazia): bootstrap.admin@example.com — sobreponha com BEABA_BOOTSTRAP_ADMIN_EMAIL.

# Senha por defeito: changeme123 (sobreponha com BEABA_BOOTSTRAP_ADMIN_PASSWORD).

# Após MFA, o primeiro acesso obriga a troca desta senha (todos os utilizadores criados via API têm a mesma regra).

# -----------------------------------------------------------------------------

# BEABA_BOOTSTRAP_ADMIN_EMAIL=bootstrap.admin@example.com

# BEABA_BOOTSTRAP_ADMIN_PASSWORD=uma_senha_forte_aqui



# -----------------------------------------------------------------------------

# SMTP — login com MFA por e-mail (obrigatório para enviar o código de 6 dígitos).

#

# Gmail (palavra-passe de *aplicação*, não a senha normal da conta):

#   SMTP_SERVER=smtp.gmail.com

#   SMTP_PORT=465

#   SMTP_USER=seu_email@gmail.com

#   SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

#   SMTP_FROM=seu_email@gmail.com

#   (porta 465 usa SSL direto em código; 587 usará STARTTLS.)

#

# Microsoft 365 / Outlook (exemplo comum ao SMTP autenticado):

#   SMTP_SERVER=smtp.office365.com

#   SMTP_PORT=587

#   SMTP_USER=seu.email@seudominio.com

#   SMTP_PASSWORD=...

#   SMTP_FROM=seu.email@seudominio.com

#

# Campos esperados pela app (`src/modules/email_utils.py`):

# -----------------------------------------------------------------------------

# SMTP_SERVER=smtp.gmail.com

# SMTP_PORT=465

# SMTP_USER=beaba@app.example

# SMTP_PASSWORD=

# SMTP_FROM=beaba@app.example

#
# Mínimo Gmail (com conta @gmail.com o servidor são predef.: smtp.gmail.com / 465):

# SMTP_USER=gestor@example.com

# SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Opcionalmente o remetente; por defeito = SMTP_USER / EMAIL_USERNAME:

# SMTP_FROM=gestor@example.com

#
# Aliases mesmo nome que secrets GitHub Actions (equivalentes a SMTP_USER / SMTP_PASSWORD / SMTP_FROM):

# EMAIL_USERNAME=gestor@example.com

# EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# EMAIL_FROM=gestor@example.com

#
# BEABA_SMTP_GMAIL=1 — força predefinição Gmail se o e-mail não for @gmail.com (ex.: domínio Google Workspace)



# -----------------------------------------------------------------------------

# Outros (documentação rápida; activar quando módulos forem criados/consumirem estas chaves).

# -----------------------------------------------------------------------------

# LOG_LEVEL=INFO

# TZ=Europe/Lisbon

# -----------------------------------------------------------------------------
# Backup encriptado (AES-256-GCM `.beaba.enc`) — uploads e drills.
# -----------------------------------------------------------------------------
# BEABA_BACKUP_KEY=base64_com_32_bytes_ou_hex_64_chars

# -----------------------------------------------------------------------------

# Armazenamento S3-compatível — envio desde `backup_sync_cloud.py` e drill em staging.
# Credenciais mínimas: S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET_NAME.

# -----------------------------------------------------------------------------
# Cloudflare R2 / DigitalOcean Spaces: defina S3_ENDPOINT_URL e região (ex.: auto).

S3_ACCESS_KEY=

S3_SECRET_KEY=

S3_BUCKET_NAME=

S3_UPLOAD_PREFIX=
# Produção exemplo: production/hourly

S3_ENDPOINT_URL=

S3_REGION=auto


# Drill (staging apenas): último objeto encriptado de produção com este prefixo.

S3_PRODUCTION_RESTORE_PREFIX=production/hourly

