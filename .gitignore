__pycache__/

# --- Open Source seguro: nunca versionar segredos locais ---
.env
.env.*
!.env.example

# SQLite (operacional, WAL, cópias locais)
*.db
*.db-wal
*.db-shm
data/*
!data/.gitkeep

# Backups locais (réplicas, filas, logs internos)
backups/
!backups/.gitkeep
!backups/**/.gitkeep

# Logs operacionais
logs/
*.log
backups/logs/
backups/**/logs/

# Blobs encriptados e estado efémero de backup
*.beaba.enc
gha_backup_state.json
gha_restore_state.json
data/.last_cloud_sync_trigger

# Telemetria de governança (metadados de CI — gerar localmente)
docs/governanca/telemetry/*.json
!docs/governanca/telemetry/*.json.example

# E20 — relatório gerado por stress E2E
tests/last_stress_report.txt

venv/
.venv/

# Artefactos locais de teste / restore
email_ok_body.html
email_ok_body.txt
restore_result.json
